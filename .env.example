# Discogs personal access token (discogs.com/settings/developers)
DISCOGS_TOKEN=

# Apps Script Web App bound to the Google Sheet (see scripts/apps-script/Code.gs),
# used by scripts/update-album-years.mjs to write back to the sheet without a
# Google Cloud OAuth client — the deployment executes as the sheet owner.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
